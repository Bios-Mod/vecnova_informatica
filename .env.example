# Configuracion central del sitio y titular
# Todos los valores personales y de contacto se leen aqui.
# Si faltan, la web utiliza marcadores TODO_* para desarrollo y pruebas.

PUBLIC_SITE_OWNER=
PUBLIC_SITE_NIE=
PUBLIC_SITE_ADDRESS=
PUBLIC_SITE_EMAIL=
PUBLIC_SITE_PHONE=
PUBLIC_SITE_URL=
PUBLIC_SITE_REPO_URL=
PUBLIC_SITE_LOGO_PATH=

# Ruta base si el sitio se sirve bajo una subruta (por defecto "/"). Normalmente vacia.
PUBLIC_BASE_PATH=

# Bandera de lanzamiento: 'true' para permitir indexacion y sitemap en produccion.
# Por defecto ('false' o ausente), inyecta noindex,nofollow y Disallow: / en robots.txt.
PUBLIC_LAUNCH=false
