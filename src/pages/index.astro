---
/**
 * index.astro — Página única unificada con navegación por anclas (Fase 2, P-042).
 * Secciones principales en orden:
 *   #inicio -> #situaciones -> #servicios -> #evidencia -> #sobre-nosotros -> #contacto
 *
 * Reglas vigentes:
 *   - Único H1 en #inicio; H2 por sección principal; H3/H4 en subsecciones y tarjetas.
 *   - Un solo mecanismo de scroll suave (html scroll-behavior en global.css + scroll-mt-*).
 *   - Revelado único en scroll-reveal.js y alturas naturales sin min-h en secciones de contenido.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SphereHero from '../components/SphereHero.astro';
import NetworkNodes from '../components/NetworkNodes.astro';
import TerminalCard from '../components/TerminalCard.astro';
import TechIcon from '../components/TechIcon.astro';
import {
  siteConfig,
  withBase,
  isValidSiteUrl,
  hasRealEmail,
  hasRealPhone,
  getTelUrl,
} from '../config/site';

const rawRepoUrl = import.meta.env.PUBLIC_SITE_REPO_URL;
const repoUrl = isValidSiteUrl(rawRepoUrl) ? rawRepoUrl!.trim() : null;

// Ritmo vertical y alturas de sección (único punto de ajuste)
const SECTION_PADDING = 'py-20 sm:py-28';
const SHORT_SECTION_LAYOUT = 'min-h-[65vh] flex flex-col justify-center';
const SERVICES_BLOCK_PADDING = 'py-12 sm:py-20';

const TECH_ROW_1 = [
  { icon: 'ubuntu', nombre: 'Ubuntu Linux' },
  { icon: 'aws', nombre: 'Amazon Web Services' },
  { icon: 'docker', nombre: 'Docker' },
  { icon: 'kubernetes', nombre: 'Kubernetes' },
  { icon: 'terraform', nombre: 'Terraform' },
  { icon: 'ansible', nombre: 'Ansible' },
  { icon: 'wireguard', nombre: 'WireGuard' },
];

const TECH_ROW_2 = [
  { icon: 'nginx', nombre: 'Nginx' },
  { icon: 'prometheus', nombre: 'Prometheus' },
  { icon: 'grafana', nombre: 'Grafana' },
  { icon: 'githubactions', nombre: 'GitHub Actions' },
  { icon: 'helm', nombre: 'Helm' },
  { icon: 'astro', nombre: 'Astro' },
  { icon: 'tailwindcss', nombre: 'Tailwind CSS' },
];
---

<BaseLayout
  title="Soluciones informáticas a medida"
  description="Soluciones informáticas a medida para particulares y pymes en Montcada i Reixac y Barcelona."
>
  <!-- Red de nodos ambiental de fondo en toda la web -->
  <NetworkNodes />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- 1. #inicio: Cabecera Hero con esfera 3D geodésica -->
    <section id="inicio" class="min-h-[calc(100vh-4rem)] supports-[height:100svh]:min-h-[calc(100svh-4rem)] flex flex-col items-center justify-center text-center py-16 sm:py-20 overflow-hidden scroll-mt-16">
      <SphereHero>
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-[4.75rem] font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] leading-[1.1] sm:leading-[1.12] hero-blur-in transition-colors">
          <span class="block">Soluciones informáticas</span>
          <span class="block mt-2 sm:mt-3 text-[#268bd2] transition-colors">
            para particulares y pymes
          </span>
        </h1>

        <p class="mt-7 sm:mt-8 text-lg sm:text-xl md:text-2xl text-[#586e75] dark:text-[#93a1a1] max-w-3xl mx-auto font-normal leading-relaxed hero-blur-in transition-colors">
          Soporte técnico presencial y soluciones de infraestructura cloud para tu negocio en Montcada i Reixac y Barcelona.
        </p>
      </SphereHero>
    </section>

    <!-- 2. #situaciones: Reconocimiento de incidencias habituales -->
    <section id="situaciones" class={`${SECTION_PADDING} ${SHORT_SECTION_LAYOUT} scroll-mt-20 gs_reveal gs_reveal_fromLeft`}>
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
          ¿Te suena alguna de estas situaciones?
        </h2>
        <p class="mt-3 text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
          Estos son algunos de los problemas que resolvemos a diario.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
        <TerminalCard>
          <h3 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-2 transition-colors">Tu equipo va lento o no arranca</h3>
          <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
            Archivos que tardan minutos en abrir, el sistema bloqueado tras encender o ventanas que no responden. Diagnosticamos, limpiamos y formateamos.
          </p>
        </TerminalCard>

        <TerminalCard>
          <h3 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-2 transition-colors">Algo dejó de funcionar después de actualizar</h3>
          <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
            La impresora ha dejado de responder, el escáner no enlaza o la conexión WiFi se desconecta sola. Localizamos el fallo de configuración o controladores y lo dejamos operativo.
          </p>
        </TerminalCard>

        <TerminalCard>
          <h3 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-2 transition-colors">No quieres perder documentos y fotos</h3>
          <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
            Años de recuerdos personales, facturación o archivos de proyectos almacenados en un único disco susceptible de fallar. Diseñamos e implementamos copias de seguridad automáticas y seguras.
          </p>
        </TerminalCard>

        <TerminalCard>
          <h3 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-2 transition-colors">El ordenador se ha quedado corto</h3>
          <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
            El ordenador todavía tiene vida útil por delante, pero le falta soltura para el día a día. Instalamos discos SSD de alta velocidad, ampliamos memoria RAM y ponemos a punto el hardware.
          </p>
        </TerminalCard>
      </div>
    </section>

    <!-- 3. #servicios: Catálogo completo de servicios en cuatro verbos -->
    <section id="servicios" class={`${SECTION_PADDING} scroll-mt-20`}>
      <h2 class="sr-only">Servicios informáticos a medida</h2>

      <!-- Resolvemos -->
      <div id="resolvemos" class="pb-12 sm:pb-20 scroll-mt-20 gs_reveal gs_reveal_fromLeft">
        <div class="max-w-3xl mb-10">
          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
            Resolvemos
          </h3>
          <p class="mt-3 text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
            Solución ágil de incidencias en equipos, sistemas operativos y periféricos.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
          <TerminalCard>
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Averías en equipos y problemas de arranque
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              Ordenadores que no encienden, pantallazos de error, bloqueos súbitos o lentitud que impide trabajar. Diagnosticamos si el fallo reside en componentes físicos (disco, memoria, placa o fuente) o en el sistema operativo (Windows o macOS), aplicando la solución más directa: saneamiento, sustitución de piezas o instalación limpia con pruebas exhaustivas de estabilidad.
            </p>
          </TerminalCard>

          <TerminalCard>
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Impresoras, red local y periféricos
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              Impresoras y escáneres que dejan de comunicarse tras actualizar el sistema, desajustes de controladores o redes WiFi con cortes y zonas sin cobertura. Configuramos periféricos compartidos en red, resolvemos incompatibilidades de controladores y optimizamos la conexión del router para trabajar con estabilidad continua.
            </p>
          </TerminalCard>
        </div>
      </div>

      <!-- Mantenemos -->
      <div id="mantenemos" class={`${SERVICES_BLOCK_PADDING} scroll-mt-20 gs_reveal gs_reveal_fromRight`}>
        <div class="max-w-3xl mb-10">
          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
            Mantenemos
          </h3>
          <p class="mt-3 text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
            Copias de seguridad automatizadas y revisiones preventivas para proteger tu información.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
          <TerminalCard>
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Copias de seguridad automatizadas y restauración
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              Tus documentos de trabajo, contabilidad, proyectos o fotografías personales no pueden depender de un único disco vulnerable a roturas, pérdidas o ransomware. Diseñamos un sistema de copias periódico y automatizado (en soporte local o nube cifrada) y realizamos pruebas periódicas de restauración para certificar que los archivos se recuperan intactos cuando hace falta.
            </p>
          </TerminalCard>

          <TerminalCard>
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Revisiones periódicas y mantenimiento preventivo
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              El software desactualizado y la acumulación de datos temporales degradan el rendimiento de los equipos con el tiempo. Realizamos limpieza lógica de sistemas, controlamos los procesos de inicio, aplicamos parches de seguridad supervisados y monitorizamos la salud física de las unidades de almacenamiento para anticiparnos a cualquier fallo.
            </p>
          </TerminalCard>
        </div>
      </div>

      <!-- Ponemos a punto -->
      <div id="ponemos-a-punto" class={`${SERVICES_BLOCK_PADDING} scroll-mt-20 gs_reveal gs_reveal_fromLeft`}>
        <div class="max-w-3xl mb-10">
          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
            Ponemos a punto
          </h3>
          <p class="mt-3 text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
            Mejora de hardware y despliegue seguro de redes locales y servidores Linux.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          <TerminalCard>
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Ampliación y montaje de equipos
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              Multiplicar la soltura de un ordenador cuesta una fracción de comprar uno nuevo. Sustituimos discos mecánicos por unidades SSD de alta velocidad, ampliamos memoria RAM compatible, renovamos pasta térmica y montamos equipos de sobremesa a medida según necesidades y presupuesto real.
            </p>
          </TerminalCard>

          <TerminalCard>
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Redes locales y conectividad segura
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              Configuración y despliegue de redes fiables para oficinas y hogares: optimización de routers, sistemas WiFi Mesh para cobertura sin cortes, cableado para puestos con alta exigencia y túneles VPN seguros con WireGuard para conectar puestos remotos con la red interna.
            </p>
          </TerminalCard>

          <TerminalCard class="sm:col-span-2 lg:col-span-1">
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Servidores Linux y bastionado
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              Instalación inicial y securización de servidores físicos o virtuales (Ubuntu 24.04). Aplicamos buenas prácticas desde el primer minuto: cortafuegos UFW, protección con Fail2Ban, perfiles AppArmor y configuraciones automatizadas con Ansible y Terraform para instalaciones reproducibles.
            </p>
          </TerminalCard>
        </div>
      </div>

      <!-- Migramos a la nube -->
      <div id="migramos-a-la-nube" class="pt-12 sm:pt-20 scroll-mt-20 gs_reveal gs_reveal_fromRight">
        <div class="max-w-3xl mb-10">
          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
            Migramos a la nube
          </h3>
          <p class="mt-3 text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
            Arquitectura cloud en AWS, contenedorización y despliegues reproducibles.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          <TerminalCard>
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Infraestructura cloud en AWS
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              Diseño e implementación en Amazon Web Services mediante infraestructura como código (Terraform). Desde entornos autocontenidos en EC2 hasta soluciones estáticas y serverless, integrando paneles de monitorización (Prometheus y Grafana) con traspaso íntegro para que conozcas el estado de tus servicios.
            </p>
          </TerminalCard>

          <TerminalCard>
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Contenedores y despliegues
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              Empaquetamos tus aplicaciones y bases de datos en contenedores Docker para garantizar un comportamiento idéntico en cualquier servidor. Automatizamos el ciclo de publicación con GitHub Actions (CI/CD) y orquestación con Kubernetes cuando la escala del proyecto lo justifique.
            </p>
          </TerminalCard>

          <TerminalCard class="sm:col-span-2 lg:col-span-1">
            <h4 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
              Desarrollo web y aplicaciones
            </h4>
            <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
              Cuando un proyecto requiere una nueva aplicación web o software a medida, {siteConfig.name} colabora en alianza técnica con MonteStack: ellos asumen el desarrollo de la aplicación y {siteConfig.name} diseña la infraestructura en la nube, seguridad y despliegue automatizado.
            </p>
          </TerminalCard>
        </div>
      </div>
    </section>

    <!-- 4. #evidencia: Evidencia técnica (repos) y Tecnologías -->
    <section id="evidencia" class={`${SECTION_PADDING} scroll-mt-20`}>
      <div class="gs_reveal gs_reveal_fromLeft">
        <div class="max-w-3xl mb-10">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
            Evidencia técnica
          </h2>
          <p class="mt-3 text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
            Implementaciones de {siteConfig.name} con código auditable, configuración reproducible y resultados medibles.
          </p>
        </div>

        <!-- Fichas de repositorios interactivas -->
        <div class="space-y-5">

          <!-- Ficha 1: build-your-infra -->
          <a
            href="https://github.com/Bios-Mod/build-your-infra"
            target="_blank"
            rel="noopener noreferrer"
            class="group block cursor-pointer focus:outline-hidden"
            aria-label="Ver repositorio de build-your-infra en GitHub"
          >
            <TerminalCard bodyClass="p-5 sm:p-6 flex flex-col justify-center">
              <div class="mb-2.5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-semibold bg-[#2aa198]/15 dark:bg-[#2aa198]/20 text-[#2aa198] border border-[#2aa198]/30">
                  Evidencia técnica
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-[#073642] group-hover:text-[#268bd2] dark:text-[#eee8d5] dark:group-hover:text-[#268bd2] font-mono mb-3 transition-colors">
                build-your-infra
              </h3>

              <p class="text-[#2b424a] dark:text-[#839496] text-sm sm:text-base leading-relaxed transition-colors">
                Aprovisionamiento y bastionado automatizado (Terraform y Ansible) de servidores Linux (Ubuntu 24.04 LTS) en entornos virtualizados locales y en AWS. Diseñado bajo el principio de defensa en profundidad, coordina cortafuegos perimetral con UFW, baneo reactivo de intrusiones con Fail2Ban, confinamiento en el kernel mediante AppArmor, registro forense con auditd e integridad de archivos con AIDE. La administración remota se realiza mediante túnel WireGuard VPN cifrado, y el nivel de endurecimiento está verificado mediante auditoría automatizada con Lynis, alcanzando un índice de 88 sobre 100 en máquina local y 90 sobre 100 en AWS EC2.
              </p>
            </TerminalCard>
          </a>

          <!-- Ficha 2: containerize-your-infra -->
          <a
            href="https://github.com/Bios-Mod/containerize-your-infra"
            target="_blank"
            rel="noopener noreferrer"
            class="group block cursor-pointer focus:outline-hidden"
            aria-label="Ver repositorio de containerize-your-infra en GitHub"
          >
            <TerminalCard bodyClass="p-5 sm:p-6 flex flex-col justify-center">
              <div class="mb-2.5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-semibold bg-[#2aa198]/15 dark:bg-[#2aa198]/20 text-[#2aa198] border border-[#2aa198]/30">
                  Evidencia técnica
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-[#073642] group-hover:text-[#268bd2] dark:text-[#eee8d5] dark:group-hover:text-[#268bd2] font-mono mb-3 transition-colors">
                containerize-your-infra
              </h3>

              <p class="text-[#2b424a] dark:text-[#839496] text-sm sm:text-base leading-relaxed transition-colors">
                Empaquetado y aislamiento de servicios en contenedores Docker reproducibles, garantizando consistencia absoluta entre entornos de desarrollo y producción. Incorpora un proxy inverso Nginx como punto único de entrada seguro para terminación TLS y buffering de tráfico, junto con un stack de observabilidad continua basado en Prometheus y Grafana para monitorizar en tiempo real el consumo de recursos y la salud del sistema. La arquitectura incluye manifiestos declarativos y charts de Helm preparados para la orquestación elástica en Kubernetes.
              </p>
            </TerminalCard>
          </a>

          <!-- Ficha 3: Web de Vecnova Informática -->
          {repoUrl ? (
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group block cursor-pointer focus:outline-hidden"
              aria-label={`Ver repositorio de ${siteConfig.name} en GitHub`}
            >
              <TerminalCard bodyClass="p-5 sm:p-6 flex flex-col justify-center">
                <div class="mb-2.5">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-semibold bg-[#268bd2]/15 dark:bg-[#268bd2]/20 text-[#268bd2] border border-[#268bd2]/30">
                    Caso de estudio
                  </span>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold text-[#073642] group-hover:text-[#268bd2] dark:text-[#eee8d5] dark:group-hover:text-[#268bd2] font-mono mb-3 transition-colors">
                  Web de {siteConfig.name}
                </h3>

                <p class="text-[#2b424a] dark:text-[#839496] text-sm sm:text-base leading-relaxed transition-colors">
                  Caso de implementación real de arquitectura estática serverless en AWS: generación estática desacoplada con Astro y Tailwind CSS alojada en un bucket Amazon S3 privado, distribuida globalmente mediante CloudFront y protegida con Origin Access Control (OAC). Funciona como demostración técnica de alta disponibilidad, cifrado TLS de extremo a extremo y mantenimiento de servidores nulo con un coste operativo residual.
                </p>
              </TerminalCard>
            </a>
          ) : (
            <div>
              <TerminalCard bodyClass="p-5 sm:p-6 flex flex-col justify-center">
                <div class="mb-2.5">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-semibold bg-[#268bd2]/15 dark:bg-[#268bd2]/20 text-[#268bd2] border border-[#268bd2]/30">
                    Caso de estudio
                  </span>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold text-[#073642] dark:text-[#eee8d5] font-mono mb-3 transition-colors">
                  Web de {siteConfig.name}
                </h3>

                <p class="text-[#2b424a] dark:text-[#839496] text-sm sm:text-base leading-relaxed transition-colors">
                  Caso de implementación real de arquitectura estática serverless en AWS: generación estática desacoplada con Astro y Tailwind CSS alojada en un bucket Amazon S3 privado, distribuida globalmente mediante CloudFront y protegida con Origin Access Control (OAC). Funciona como demostración técnica de alta disponibilidad, cifrado TLS de extremo a extremo y mantenimiento de servidores nulo con un coste operativo residual (~0,05–2 USD/mes).
                </p>
              </TerminalCard>
            </div>
          )}

        </div>
      </div>

      <!-- Tecnologías (nube / marquee) -->
      <div id="tecnologias" class="pt-14 sm:pt-20 mt-14 sm:mt-20 scroll-mt-20 gs_reveal gs_reveal_fromRight">
        <div class="max-w-3xl mb-10">
          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
            Tecnologías
          </h3>
          <p class="mt-3 text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
            Herramientas y tecnologías integradas en las implementaciones de infraestructura, contenedores y automatización de {siteConfig.name}.
          </p>
        </div>

        <!-- Contenedor Logo Cloud con máscaras de difuminado lateral suave -->
        <div class="marquee-wrapper relative overflow-hidden py-4 [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)] select-none">

          <!-- Fila 1: Desplazamiento continuo hacia la izquierda -->
          <div class="animate-marquee-left flex gap-3.5 mb-3.5">
            {TECH_ROW_1.concat(TECH_ROW_1).map((tech) => (
