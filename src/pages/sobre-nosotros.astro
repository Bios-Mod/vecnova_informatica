---
/**
 * sobre-nosotros.astro — Página «Sobre Vecnova Informática».
 * Presentación de la marca, experiencia en el sector IT y alianzas técnicas.
 *
 * Reglas de diseño y contenido (P-021, P-037, P-040, T-012):
 *   - Título sobrio y directo: "Sobre Vecnova Informática".
 *   - Estructura compacta en 2 momentos reales: Trayectoria y Partners (una tarjeta por sección).
 *   - Voz de marca impersonal (sin nombres propios ni plurales de equipo).
 *   - Alianza técnica con MonteStack: tarjeta única con enlace directo a su web.
 *   - Estética Solarized Light (#fdf6e3, #073642, #2b424a, #586e75, #268bd2, #2aa198) con red de nodos ambiental y TerminalCard.
 *   - Coreografía alternada GSAP ScrollTrigger (Izquierda -> Derecha -> Izquierda).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkNodes from '../components/NetworkNodes.astro';
import TerminalCard from '../components/TerminalCard.astro';
import { siteConfig, withBase } from '../config/site';
---

<BaseLayout
  title="Sobre nosotros"
  description={`Información sobre ${siteConfig.name}, experiencia en soporte IT e infraestructura cloud y alianza técnica con MonteStack.`}
>
  <!-- Red de nodos ambiental de fondo en toda la web -->
  <NetworkNodes />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Cabecera de Sobre nosotros: Sobria, centrada y con entrada suave -->
    <header class="py-12 sm:py-16 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#2aa198] leading-tight hero-blur-in transition-colors">
        Sobre nosotros
      </h1>
    </header>

    <!-- Momento 1: Trayectoria — Entra desde la izquierda con GSAP -->
    <section id="trayectoria" class="py-14 sm:py-20 scroll-mt-20 gs_reveal gs_reveal_fromLeft">
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
          Trayectoria
        </h2>
        <p class="mt-3 text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
          Soporte informático presencial e infraestructura cloud para particulares y pequeñas empresas de Montcada i Reixac y Barcelona.
        </p>
      </div>

      <div class="max-w-2xl">
        <TerminalCard>
          <h3 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] mb-3 transition-colors">
            Nuestra experiencia en TI
          </h3>
          <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base transition-colors">
            Años resolviendo incidencias técnicas en el día a día de particulares y empresas. Conocer de primera mano el comportamiento físico de los equipos y las necesidades de los usuarios permite plantear soluciones directas, estables y adaptadas a cada caso, con trato directo con quien analiza, diseña y ejecuta.
          </p>
        </TerminalCard>
      </div>
    </section>

    <!-- Momento 2: Partners — Entra desde la derecha con GSAP -->
    <section id="alianzas" class="py-14 sm:py-20 scroll-mt-20 gs_reveal gs_reveal_fromRight">
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
          Partners
        </h2>
        <p class="mt-3 text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
          Alianza técnica con especialistas para proyectos integrales.
        </p>
      </div>

      <div class="max-w-2xl">
        <TerminalCard>
          <div class="flex items-center gap-3 mb-3">
            <img
              src={withBase('/montestack-logo.png')}
              alt="Logo de MonteStack"
              class="w-7 h-7 sm:w-8 sm:h-8 object-contain shrink-0"
              width="32"
              height="32"
              loading="lazy"
            />
            <h3 class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] transition-colors">
              MonteStack
            </h3>
          </div>
          <p class="text-[#2b424a] dark:text-[#839496] leading-relaxed text-sm sm:text-base mb-6 transition-colors">
            Especialistas en análisis, desarrollo de software y plataformas web a medida. Asumen íntegramente la ingeniería de software y el código de la aplicación para proyectos que requieren soluciones digitales sólidas y escalables.
          </p>
          <div>
            <a
              href="https://montestack.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-sm font-semibold text-[#268bd2] hover:text-[#1f73ad] dark:hover:text-[#2aa198] group transition-colors"
            >
              Visitar montestack.vercel.app
              <span class="ml-1.5 transition-transform group-hover:translate-x-1">→</span>
            </a>
          </div>
        </TerminalCard>
      </div>
    </section>

    <!-- Cierre / CTA hacia Contacto y Servicios — Entra desde la izquierda con GSAP -->
    <section class="py-16 sm:py-20 text-center gs_reveal gs_reveal_fromLeft">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#073642] dark:text-[#eee8d5] transition-colors">
          Consulta directa
        </h2>
        <p class="mt-4 text-base sm:text-lg text-[#586e75] dark:text-[#93a1a1] transition-colors">
          Cuéntanos qué necesitas y valoramos juntos la solución más directa y conveniente.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={withBase('/contacto/')}
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-white bg-[#268bd2] rounded-xl hover:bg-[#1f73ad] shadow-sm hover:shadow transition-all"
          >
            Contactar
          </a>
          <a
            href={withBase('/servicios/')}
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-base font-medium text-[#073642] dark:text-[#eee8d5] bg-[#eee8d5] dark:bg-[#073642] border border-[#d8d0bb] dark:border-[#0a4756] rounded-xl hover:border-[#268bd2] dark:hover:border-[#2aa198] transition-colors"
          >
            Ver catálogo de servicios →
          </a>
        </div>
      </div>
    </section>

  </main>

  <script>
    import '../scripts/scroll-reveal.js';
  </script>
</BaseLayout>
