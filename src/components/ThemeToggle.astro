---
/**
 * ThemeToggle.astro — Conmutador de tema Solarized Light / Solarized Dark.
 *
 * Comportamiento:
 * - Detecta automáticamente la preferencia del sistema operativo (prefers-color-scheme).
 * - Permite alternar manualmente y persiste la elección en localStorage.
 * - Iconos SVG sobrios (Sol en modo oscuro / Luna en modo claro).
 */
interface Props {
  class?: string;
  id?: string;
}

const { class: className = '', id = 'theme-toggle-btn' } = Astro.props;
---

<button
  id={id}
  type="button"
  class:list={[
    "theme-toggle-button inline-flex items-center justify-center p-2 rounded-xl text-[#586e75] hover:text-[#073642] hover:bg-[#eee8d5]/80 dark:text-[#93a1a1] dark:hover:text-[#eee8d5] dark:hover:bg-[#073642]/80 border border-transparent hover:border-[#d8d0bb] dark:hover:border-[#0a4756] transition-all cursor-pointer focus:outline-hidden",
    className
  ]}
  aria-label="Alternar tema claro y oscuro"
  title="Alternar tema claro y oscuro"
>
  <!-- Icono Sol (se muestra en modo oscuro para volver al modo claro) -->
  <svg
    class="w-5 h-5 hidden dark:block text-[#b58900] transition-transform duration-300 rotate-0 hover:rotate-45"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
  </svg>

  <!-- Icono Luna (se muestra en modo claro para cambiar a modo oscuro) -->
  <svg
    class="w-5 h-5 block dark:hidden text-[#268bd2] transition-transform duration-300 -rotate-12 hover:rotate-0"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  function setupThemeToggles() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-button');
    if (!buttons.length) return;

    buttons.forEach((btn) => {
      // Eliminar listeners previos para evitar duplicados en navegaciones
      btn.replaceWith(btn.cloneNode(true));
    });

    const activeButtons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-button');

    activeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        const nextTheme = isDark ? 'light' : 'dark';

        if (nextTheme === 'dark') {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        }

        // Disparar evento personalizado para sincronizar si hay otros componentes
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: nextTheme } }));
      });
    });
  }

  // Ejecutar en carga inicial y tras cada navegación si hubiera view transitions
  setupThemeToggles();
  document.addEventListener('astro:page-load', setupThemeToggles);
</script>
