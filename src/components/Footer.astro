---
/**
 * Footer.astro — Pie de página común.
 * Sencillo, con marca y enlaces básicos e institucionales.
 */
import { siteConfig, withBase, isRealValue } from '../config/site';
---

<footer class="border-t border-[#e5dec9] dark:border-[#073642] bg-[#fdf6e3] dark:bg-[#002b36] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        {isRealValue(siteConfig.logoPath) && (
          <a href={withBase('/')} class="flex items-center shrink-0" aria-label={`Inicio de ${siteConfig.name}`}>
            <img
              src={withBase(siteConfig.logoPath)}
              alt={siteConfig.name}
              width="24"
              height="24"
              class="h-6 w-6 object-contain block dark:hidden"
            />
            <img
              src={withBase(siteConfig.logoDarkPath)}
              alt={siteConfig.name}
              width="24"
              height="24"
              class="h-6 w-6 object-contain hidden dark:block"
            />
          </a>
        )}
        <p class="text-sm text-[#657b83] dark:text-[#839496]">
          &copy; {new Date().getFullYear()} {siteConfig.name}. Infraestructura cloud y soporte TI.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={withBase('/#contacto')} class="text-sm text-[#657b83] hover:text-[#073642] dark:text-[#839496] dark:hover:text-[#eee8d5] transition-colors">
          Contacto
        </a>
        <a href={withBase('/aviso-legal/')} class="text-sm text-[#657b83] hover:text-[#073642] dark:text-[#839496] dark:hover:text-[#eee8d5] transition-colors">
          Aviso legal
        </a>
        <a href={withBase('/privacidad/')} class="text-sm text-[#657b83] hover:text-[#073642] dark:text-[#839496] dark:hover:text-[#eee8d5] transition-colors">
          Privacidad
        </a>
        <a href={withBase('/third-party-notices.txt')} target="_blank" rel="noopener noreferrer" class="text-sm text-[#657b83] hover:text-[#073642] dark:text-[#839496] dark:hover:text-[#eee8d5] transition-colors">
          Licencias de terceros
        </a>
      </div>
    </div>
  </div>
</footer>
