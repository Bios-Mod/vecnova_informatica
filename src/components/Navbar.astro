---
/**
 * Navbar.astro — Barra de navegación principal.
 * Fija en la parte superior, fuera del flujo de scroll (P-032).
 * Enlace a anclas de la página única (/#ancla) para funcionar también desde páginas legales y 404.
 * Resalta el enlace activo mediante IntersectionObserver (aria-current) y cierra el menú móvil al pulsar.
 */

import ThemeToggle from './ThemeToggle.astro';
import { siteConfig, withBase, isRealValue } from '../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath: _currentPath = '/' } = Astro.props;

const links = [
  { href: withBase('/#servicios'), section: 'servicios', label: 'Servicios' },
  { href: withBase('/#evidencia'), section: 'evidencia', label: 'Evidencia técnica' },
  { href: withBase('/#sobre-nosotros'), section: 'sobre-nosotros', label: 'Sobre nosotros' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[#fdf6e3]/90 dark:bg-[#002b36]/90 backdrop-blur-md border-b border-[#e5dec9] dark:border-[#073642] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / Marca -->
      <a href={withBase('/#inicio')} class="text-xl font-bold text-[#073642] dark:text-[#eee8d5] transition-colors flex items-center gap-2">
        {isRealValue(siteConfig.logoPath) && (
          <>
            <img
              src={withBase(siteConfig.logoPath)}
              alt={siteConfig.name}
              width="28"
              height="28"
              class="h-7 w-7 object-contain block dark:hidden"
            />
            <img
              src={withBase(siteConfig.logoDarkPath)}
              alt={siteConfig.name}
              width="28"
              height="28"
              class="h-7 w-7 object-contain hidden dark:block"
            />
          </>
        )}
        <span>{siteConfig.name}</span>
      </a>

      <!-- Enlaces de escritorio -->
      <div class="hidden md:flex items-center gap-5">
        {links.map((link) => (
          <a
            href={link.href}
            data-nav-section={link.section}
            data-nav-variant="desktop-link"
            class="text-sm font-medium transition-colors text-[#657b83] hover:text-[#073642] dark:text-[#93a1a1] dark:hover:text-[#eee8d5]"
          >
            {link.label}
          </a>
        ))}

        <a
          href={withBase('/#contacto')}
          data-nav-section="contacto"
          data-nav-variant="cta"
          class="ml-1 inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[#268bd2] rounded-xl hover:bg-[#1f73ad] transition-all shadow-xs"
        >
          Contactar
        </a>

        <!-- Conmutador de modo claro / oscuro Solarized -->
        <ThemeToggle id="theme-toggle-desktop" />
      </div>

      <!-- Acciones móvil (Switch de tema + Botón hamburguesa) -->
      <div class="md:hidden flex items-center gap-1.5">
        <ThemeToggle id="theme-toggle-mobile" />

        <button
          id="mobile-menu-btn"
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-xl text-[#586e75] hover:text-[#073642] hover:bg-[#eee8d5]/80 dark:text-[#93a1a1] dark:hover:text-[#eee8d5] dark:hover:bg-[#073642]/80 transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
        >
          <!-- Icono hamburguesa -->
          <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <!-- Icono cerrar -->
          <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú móvil (oculto por defecto) -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-[#e5dec9] dark:border-[#073642] bg-[#fdf6e3] dark:bg-[#073642] transition-colors">
    <div class="px-4 py-3 space-y-2">
      {links.map((link) => (
        <a
          href={link.href}
          data-nav-section={link.section}
          data-nav-variant="mobile-link"
          class="block px-3 py-2 rounded-xl text-base font-medium transition-colors text-[#586e75] hover:text-[#073642] hover:bg-[#eee8d5]/60 dark:text-[#93a1a1] dark:hover:text-[#eee8d5] dark:hover:bg-[#002b36]/60"
        >
          {link.label}
        </a>
      ))}
      <a
        href={withBase('/#contacto')}
        data-nav-section="contacto"
        data-nav-variant="cta"
        class="block mt-2 text-center px-4 py-2.5 text-sm font-medium text-white bg-[#268bd2] rounded-xl hover:bg-[#1f73ad] transition-all shadow-xs"
      >
        Contactar
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function closeMobileMenu() {
    btn?.setAttribute('aria-expanded', 'false');
    menu?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMobileMenu);
  });

  // Resaltado de enlace activo según sección visible (solo en página única)
  const navTargets = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]'));
  const observedIds = ['inicio', 'situaciones', 'servicios', 'evidencia', 'sobre-nosotros', 'contacto'];
  const observedElements = observedIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const desktopInactive = ['text-[#657b83]', 'hover:text-[#073642]', 'dark:text-[#93a1a1]', 'dark:hover:text-[#eee8d5]'];
  const desktopActive = ['text-[#268bd2]'];
  const mobileInactive = ['text-[#586e75]', 'hover:text-[#073642]', 'hover:bg-[#eee8d5]/60', 'dark:text-[#93a1a1]', 'dark:hover:text-[#eee8d5]', 'dark:hover:bg-[#002b36]/60'];
  const mobileActive = ['text-[#268bd2]', 'bg-[#eee8d5]', 'dark:bg-[#002b36]'];

  let currentActive: string | null = null;

  function setActiveSection(sectionId: string | null) {
    if (currentActive === sectionId) return;
    currentActive = sectionId;

    navTargets.forEach((el) => {
      const target = el.dataset.navSection;
      const variant = el.dataset.navVariant;
      const isActive = sectionId !== null && target === sectionId;

      if (isActive) {
        el.setAttribute('aria-current', 'location');
      } else {
        el.removeAttribute('aria-current');
      }

      if (variant === 'desktop-link') {
        el.classList.remove(...(isActive ? desktopInactive : desktopActive));
        el.classList.add(...(isActive ? desktopActive : desktopInactive));
      } else if (variant === 'mobile-link') {
        el.classList.remove(...(isActive ? mobileInactive : mobileActive));
        el.classList.add(...(isActive ? mobileActive : mobileInactive));
      } else if (variant === 'cta') {
        el.classList.toggle('ring-2', isActive);
        el.classList.toggle('ring-[#268bd2]/50', isActive);
        el.classList.toggle('ring-offset-2', isActive);
        el.classList.toggle('ring-offset-[#fdf6e3]', isActive);
        el.classList.toggle('dark:ring-offset-[#002b36]', isActive);
      }
    });
  }

  if (observedElements.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            if (id === 'inicio' || id === 'situaciones') {
              setActiveSection(null);
            } else {
              setActiveSection(id);
            }
          }
        }
      },
      {
        rootMargin: '-20% 0px -65% 0px',
        threshold: 0,
      }
    );

    observedElements.forEach((el) => observer.observe(el));

    const contactoEl = document.getElementById('contacto');
    if (contactoEl) {
      window.addEventListener(
        'scroll',
        () => {
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 24) {
            setActiveSection('contacto');
          }
        },
        { passive: true }
      );
    }
  }
</script>
